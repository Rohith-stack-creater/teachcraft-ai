NEXT_PUBLIC_DEMO_MODE=true

# Server-only provider selection. Never expose provider keys in NEXT_PUBLIC_* variables.
# Set TEACHCRAFT_PROVIDER=gemini to use Gemini; otherwise Anthropic is used.
TEACHCRAFT_PROVIDER=gemini

# Gemini server-only settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic server-only settings, retained as an optional fallback/provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional server-only reliability and usage controls.
TEACHCRAFT_GENERATION_TIMEOUT_MS=30000
TEACHCRAFT_DAILY_LESSON_LIMIT=10
TEACHCRAFT_DAILY_ARC_LIMIT=3
TEACHCRAFT_GENERATION_COOLDOWN_SECONDS=10

# Supabase project settings. Add these after creating the project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Intended deployment region for the future Supabase project:
# ap-south-1 (Mumbai, India)
